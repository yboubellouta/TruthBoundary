rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the logged-in user is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection — users can read their own doc, only admins can write
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // Content collection — anyone authenticated can read, only admins can write/delete
    match /content/{cardId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}
